{
  "name": "quantum-flip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Quantum Flip: a free-to-play on-chain coin-flip game on the QoreChain testnet (qorechain-diana). Every flip is an EVM transaction admitted only inside a post-quantum authorisation window, so each move is quantum-safe by construction.",
  "scripts": {
    "compile": "npx solc@0.8.24 --optimize --abi --bin -o out contracts/QuantumFlip.sol contracts/StreakBadge.sol && node scripts/build-artifact.mjs",
    "deploy": "tsx --env-file=.env scripts/deploy.ts",
    "deploy-streak-badge": "tsx --env-file=.env scripts/deploy-streak-badge.ts",
    "window": "tsx --env-file=.env scripts/window.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qorex-rainbowkit": "^0.1.0",
    "@qorechain/sdk": "^0.14.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.0.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ganache": "^7.9.2",
    "https-proxy-agent": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
